        <div class="field-head">
          <label class="field-label" for="retReturn">In-retirement ROI <span class="info">i<span class="tip">Most investors shift to safer assets during retirement, lowering the expected return on their portfolio.</span></span></label>
        </div>
        <div class="input-row key-input"><input type="number" id="retReturn" value="5" min="0" max="12" step="0.1"><span class="suffix">%</span></div>
        <input type="range" id="retReturnSlider" min="0" max="12" value="5" step="0.1">
      </div>

      <div class="field">
        <div class="field-head">
          <label class="field-label" for="inflation">Estimated average annual inflation rate <span class="info">i<span class="tip">The historical average for U.S. inflation has approximated 3%. This erodes the buying power of every dollar you save.</span></span></label>
        </div>
        <div class="input-row"><input type="number" id="inflation" value="3" min="0" max="10" step="0.1"><span class="suffix">%</span></div>
        <input type="range" id="inflationSlider" min="0" max="10" value="3" step="0.1">
