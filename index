<div class="foot">
  <span>Educational model. All retirement calculations are mathematical projections of input assumptions — your estimate is only as accurate as the assumptions you make.</span>
  <span>v1.1</span>
</div>

<!-- PDF instructions modal -->
<div class="modal-overlay" id="pdfModal" role="dialog" aria-labelledby="pdfModalTitle">
  <div class="modal">
    <div class="modal-title" id="pdfModalTitle">Saving your results as a PDF</div>
    <div class="modal-intro">Your browser's print dialog will open next. Follow these three steps to save a clean copy of your work:</div>
    <ol class="modal-steps">
      <li>Set <strong>Destination</strong> to <strong>"Save as PDF"</strong> (instead of a printer).</li>
      <li>Open <strong>"More settings"</strong> and check the box for <strong>"Background graphics"</strong>. This keeps the colored bars and numbers in your saved PDF.</li>
      <li>Click <strong>Save</strong> and choose where to save the file on your computer.</li>
    </ol>
    <div class="modal-note">If you skip step 2, the bars in your PDF will appear blank or white. The chart needs background graphics turned on to show colors.</div>
    <div class="modal-actions">
      <button class="btn" id="pdfCancel">Cancel</button>
      <button class="btn btn-primary" id="pdfContinue">Open print dialog</button>
    </div>
  </div>
</div>

<script>
const DEFAULTS = {
  currentAge: 22, retireAge: 65, lifeExp: 92,
  currentSavings: 2000, monthlySave: 500, annualNeed: 48000,
  returnRate: 7, retReturn: 5, inflation: 3, taxRate: 15
};
const inputs = { ...DEFAULTS };

// ============== MATH ==============
function project(overrides) {
  const inp = overrides ? { ...inputs, ...overrides } : inputs;
  const yearsToRetire = Math.max(0, inp.retireAge - inp.currentAge);
  const yearsInRetire = Math.max(0, inp.lifeExp - inp.retireAge);
  const r = inp.returnRate / 100;
  const rRet = inp.retReturn / 100;
  const infl = inp.inflation / 100;
  const tax = inp.taxRate / 100;

  // Accumulation phase: monthly compounding with contributions
  let balance = inp.currentSavings;
  const monthlyR = Math.pow(1 + r, 1/12) - 1;

  for (let y = 1; y <= yearsToRetire; y++) {
    for (let m = 0; m < 12; m++) {
      balance = balance * (1 + monthlyR) + inp.monthlySave;
    }
  }

  const nestEgg = balance;

  // Required nest egg uses pre-tax need (gross-up by 1/(1-tax))
  const inflFactor = Math.pow(1 + infl, yearsToRetire);
  const realRet = (1 + rRet) / (1 + infl) - 1;
  const preTaxFactor = tax >= 1 ? 1 : 1 / (1 - tax);
  const annualGrossNeedToday = inp.annualNeed * preTaxFactor;

  let requiredToday;
  if (Math.abs(realRet) < 1e-6) {
    requiredToday = annualGrossNeedToday * yearsInRetire;
  } else {
    requiredToday = annualGrossNeedToday * (1 - Math.pow(1 + realRet, -yearsInRetire)) / realRet;
  }
  requiredToday = Math.max(0, requiredToday);
  const requiredAtRetire = requiredToday * inflFactor;

  // Withdrawal simulation to find when money runs out
  let withdrawBalance = nestEgg;
  const monthlyRetR = Math.pow(1 + rRet, 1/12) - 1;
  let currentMonthlyGrossNeed = inp.annualNeed * preTaxFactor * inflFactor / 12;
  let lastsUntilAge = inp.retireAge;
  let exhausted = false;

  for (let y = 1; y <= yearsInRetire; y++) {
    if (exhausted) break;
    for (let m = 0; m < 12; m++) {
      withdrawBalance = withdrawBalance * (1 + monthlyRetR) - currentMonthlyGrossNeed;
      if (withdrawBalance < 0) { exhausted = true; break; }
    }
    if (!exhausted) lastsUntilAge = inp.retireAge + y;
    currentMonthlyGrossNeed *= (1 + infl);
  }

  const gap = nestEgg - requiredAtRetire;

  // Additional monthly contribution required to close the gap
  let extraMonthly = 0;
  if (gap < 0 && yearsToRetire > 0) {
    const n = yearsToRetire * 12;
    const i = monthlyR;
    if (Math.abs(i) < 1e-9) {
      extraMonthly = -gap / n;
    } else {
      extraMonthly = (-gap) * i / (Math.pow(1+i, n) - 1);
    }
  }

  return { nestEgg, lastsUntilAge, exhausted, yearsToRetire, yearsInRetire, requiredAtRetire, gap, extraMonthly };
}

// Solve for the pre-retirement ROI that drives gap to zero (binary search)
function solveRequiredROI() {
  if (inputs.retireAge <= inputs.currentAge) return null;
  let lo = -0.05, hi = 0.30;
  // Ensure bracket
  const gapAt = (rate) => project({ returnRate: rate * 100 }).gap;
  if (gapAt(hi) < 0) return { rate: hi, capped: true };  // even 30% isn't enough
  if (gapAt(lo) > 0) return { rate: lo, capped: true };  // even -5% works (impossible case)
  for (let k = 0; k < 60; k++) {
    const mid = (lo + hi) / 2;
    if (gapAt(mid) > 0) hi = mid; else lo = mid;
  }
  return { rate: (lo + hi) / 2, capped: false };
}

// ============== FORMAT ==============
function fmtMoney(n) {
  if (!isFinite(n)) return "—";
  const abs = Math.abs(n);
  let s;
  if (abs >= 1e9) s = (n/1e9).toFixed(2) + "B";
  else if (abs >= 1e6) s = (n/1e6).toFixed(2) + "M";
  else if (abs >= 1e3) s = (n/1e3).toFixed(0) + "K";
  else s = Math.round(n).toString();
  return (n < 0 ? "−$" : "$") + s.replace("-", "");
}
function fmtFull(n) {
  if (!isFinite(n)) return "—";
  return (n < 0 ? "−$" : "$") + Math.round(Math.abs(n)).toLocaleString();
}

// ============== RENDER ==============
function render() {
  const p = project();

  // Headline: Surplus / Shortfall
  const headlineCard = document.getElementById('headlineCard');
  const gapValue = document.getElementById('gapValue');
  const gapCaption = document.getElementById('gapCaption');

  gapValue.textContent = fmtFull(p.gap);
  headlineCard.classList.remove('is-surplus', 'is-shortfall');
  if (p.gap >= 0) {
    gapValue.classList.add('pos');
    gapValue.classList.remove('neg');
    headlineCard.classList.add('is-surplus');
    if (p.gap < p.requiredAtRetire * 0.05) {
      gapCaption.textContent = "Your savings are projected to fund the plan with a thin margin. Real markets are more volatile than this projection.";
    } else {
      gapCaption.textContent = "Your savings are projected to exceed what the plan requires. You have a cushion against the unknowable future.";
    }
  } else {
    gapValue.classList.add('neg');
    gapValue.classList.remove('pos');
    headlineCard.classList.add('is-shortfall');
    const pct = p.requiredAtRetire > 0 ? Math.round(100 * p.nestEgg / p.requiredAtRetire) : 0;
    gapCaption.textContent = `Your savings cover about ${pct}% of what's needed. To close the gap, increase contributions, retire later, lower your desired income, or aim for a higher return.`;
  }

  // Vertical bar comparison
  const maxVal = Math.max(p.nestEgg, p.requiredAtRetire, 1);
  const savingsPct = Math.min(100, (p.nestEgg / maxVal) * 100);
  const neededPct = Math.min(100, (p.requiredAtRetire / maxVal) * 100);
  const savingsBar = document.getElementById('savingsBar');
  savingsBar.style.height = savingsPct + '%';
  document.getElementById('neededBar').style.height = neededPct + '%';
  document.getElementById('nestEggValue').textContent = fmtFull(p.nestEgg);
  document.getElementById('targetValue').textContent = fmtFull(p.requiredAtRetire);

  // Color the savings bar based on surplus/shortfall
  savingsBar.classList.remove('savings-pos', 'savings-neg');
  savingsBar.classList.add(p.gap >= 0 ? 'savings-pos' : 'savings-neg');

  // Match value-label color to its bar
  const nestEggValueEl = document.getElementById('nestEggValue');
  nestEggValueEl.style.color = p.gap >= 0 ? 'var(--green)' : 'var(--red)';

  // Update legend swatch to match current bar color
  const legendSwatch = document.getElementById('legendSavings');
  if (legendSwatch) {
    legendSwatch.style.background = p.gap >= 0 ? 'var(--green-bar)' : 'var(--red-bar)';
  }

  // Supporting metrics
  const extraEl = document.getElementById('extraNeeded');
  if (p.extraMonthly > 0) {
    extraEl.textContent = fmtFull(p.extraMonthly) + "/mo";
    extraEl.className = "metric-value neg";
  } else {
    extraEl.textContent = "$0/mo";
    extraEl.className = "metric-value pos";
  }

  const roiSol = solveRequiredROI();
  const roiEl = document.getElementById('requiredROI');
  const roiSub = document.getElementById('requiredROISub');
  if (roiSol === null) {
    roiEl.textContent = "—";
    roiSub.textContent = "already at retirement";
  } else if (roiSol.capped) {
    roiEl.textContent = roiSol.rate >= 0.30 ? ">30%" : "<0%";
    roiSub.textContent = "outside reasonable range";
  } else {
    const pct = (roiSol.rate * 100);
    roiEl.textContent = pct.toFixed(2) + "%";
    const delta = pct - inputs.returnRate;
    roiSub.textContent = "average annual return needed";
    if (Math.abs(delta) < 0.05 || delta < 0) {
      roiEl.className = "metric-value pos";
    } else {
      roiEl.className = "metric-value neg";
    }
  }

  const lu = document.getElementById('lastsUntil');
  if (p.exhausted) {
    lu.textContent = p.lastsUntilAge;
    lu.className = "metric-value neg";
    document.getElementById('lastsUntilSub').textContent = `${inputs.lifeExp - p.lastsUntilAge} years short of life expectancy`;
  } else {
    lu.textContent = `${inputs.lifeExp}+`;
    lu.className = "metric-value pos";
    document.getElementById('lastsUntilSub').textContent = "money lasts to planned life expectancy";
  }
}

// ============== BINDINGS ==============
function bindPair(id) {
  const num = document.getElementById(id);
  const slider = document.getElementById(id + "Slider");
  const apply = (v) => {
    const val = parseFloat(v);
    if (!isFinite(val)) return;
    inputs[id] = val;
    if (num.value != val) num.value = val;
    if (slider && slider.value != val) slider.value = val;
    render();
  };
  num.addEventListener('input', e => apply(e.target.value));
  if (slider) slider.addEventListener('input', e => apply(e.target.value));
}
Object.keys(DEFAULTS).forEach(bindPair);

// Calculate button — re-renders, gives subtle visual confirmation
document.getElementById('calcBtn').addEventListener('click', () => {
  render();
  const card = document.getElementById('headlineCard');
  card.style.transition = 'transform 0.2s ease';
  card.style.transform = 'scale(1.01)';
  setTimeout(() => { card.style.transform = ''; }, 200);
  card.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('resetBtn').addEventListener('click', () => {
  Object.assign(inputs, DEFAULTS);
  for (const k in DEFAULTS) {
    const el = document.getElementById(k);
    if (el) el.value = DEFAULTS[k];
    const sl = document.getElementById(k + "Slider");
    if (sl) sl.value = DEFAULTS[k];
  }
  render();
});

document.getElementById('copyBtn').addEventListener('click', async () => {
  const p = project();
  const roiSol = solveRequiredROI();
  const roiText = roiSol && !roiSol.capped ? (roiSol.rate * 100).toFixed(2) + "%" : "outside range";
  const text = `Retirement Calculator — Summary

Personal Information
  Current age: ${inputs.currentAge}
  Retirement age: ${inputs.retireAge}
  Life expectancy: ${inputs.lifeExp}

Conventional Retirement Planning
  Current total savings: ${fmtFull(inputs.currentSavings)}
  Monthly savings contribution: ${fmtFull(inputs.monthlySave)}
  Desired annual retirement income: ${fmtFull(inputs.annualNeed)}

Assumptions
  Pre-retirement ROI: ${inputs.returnRate}%
  In-retirement ROI: ${inputs.retReturn}%
  Inflation rate: ${inputs.inflation}%
  Tax rate during retirement: ${inputs.taxRate}%

Results
  Projected Savings:                 ${fmtFull(p.nestEgg)}
  Required Savings:                  ${fmtFull(p.requiredAtRetire)}
  Savings Surplus / Shortfall:                     ${fmtFull(p.gap)}
  Additional Monthly Contribution Needed:          ${fmtFull(p.extraMonthly)}/mo
  Required ROI to Fully Fund Plan:                 ${roiText}
  Money lasts until:                               age ${p.exhausted ? p.lastsUntilAge : inputs.lifeExp + '+'}`;
  try {
    await navigator.clipboard.writeText(text);
    const btn = document.getElementById('copyBtn');
    const orig = btn.textContent;
    btn.textContent = "Copied ✓";
    setTimeout(() => { btn.textContent = orig; }, 1500);
  } catch(e) {}
});

// Save as PDF — first show instructions modal, then trigger browser print-to-PDF
function openPdfModal() {
  document.getElementById('pdfModal').classList.add('open');
}
document.getElementById('pdfBtn').addEventListener('click', openPdfModal);
document.getElementById('pdfBtnTop').addEventListener('click', openPdfModal);

document.getElementById('pdfCancel').addEventListener('click', () => {
  document.getElementById('pdfModal').classList.remove('open');
});

document.getElementById('pdfContinue').addEventListener('click', () => {
  // Close modal first so it isn't captured in the print preview
  document.getElementById('pdfModal').classList.remove('open');
  // Stamp the print header with today's date
  const now = new Date();
  document.getElementById('printDate').textContent =
    "Generated " + now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  // Tiny delay so the DOM reflects the modal closing before print opens
  setTimeout(() => window.print(), 80);
});

// Click outside the modal to close
document.getElementById('pdfModal').addEventListener('click', (e) => {
  if (e.target.id === 'pdfModal') {
    document.getElementById('pdfModal').classList.remove('open');
  }
});

// Force-reset all inputs to defaults on every page load — prevents browser
// from restoring cached values from a previous session.
document.querySelectorAll('input').forEach(el => el.setAttribute('autocomplete', 'off'));
Object.assign(inputs, DEFAULTS);
for (const k in DEFAULTS) {
  const el = document.getElementById(k);
  if (el) el.value = DEFAULTS[k];
  const sl = document.getElementById(k + "Slider");
  if (sl) sl.value = DEFAULTS[k];
}

render();
</script>
