    <div class="field-group">
      <div class="section-heading">Investment Return &amp; Inflation</div>

      <div class="field">
        <div class="field-head">
          <label class="field-label" for="returnRate">Pre-retirement ROI <span class="info">i<span class="tip">This is the key lever. Tune it up or down until your Surplus / Shortfall lands near zero — that's the average annual return your plan requires to succeed.</span></span></label>
        </div>
        <div class="input-row key-input"><input type="number" id="returnRate" value="7" min="0" max="15" step="0.1"><span class="suffix">%</span></div>
