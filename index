  </aside>

  <section class="results">

    <!-- HEADLINE RESULT: Savings Surplus / Shortfall -->
    <div class="headline-result" id="headlineCard">
      <button class="btn btn-primary headline-action" id="pdfBtnTop">
        <span class="pdf-icon" aria-hidden="true">⬇</span> Save as PDF
