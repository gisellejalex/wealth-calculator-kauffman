    <!-- SUPPORTING METRICS -->
    <div class="metrics">
      <div class="metric">
        <div class="metric-label">Additional Monthly Contribution Needed</div>
        <div class="metric-value" id="extraNeeded">—</div>
        <div class="metric-sub">to fully fund plan</div>
      </div>
      <div class="metric">
        <div class="metric-label">Required ROI to Fully Fund Plan</div>
        <div class="metric-value" id="requiredROI">—</div>
        <div class="metric-sub" id="requiredROISub">average annual return needed</div>
      </div>
      <div class="metric">
        <div class="metric-label">Money Lasts Until Age</div>
