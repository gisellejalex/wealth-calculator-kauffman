      <div class="field">
        <div class="field-head">
          <label class="field-label" for="taxRate">Estimated tax rate during retirement <span class="info">i<span class="tip">Withdrawals from tax-deferred accounts are taxable income. This grosses up the amount you must withdraw to actually receive your desired retirement income.</span></span></label>
        </div>
        <div class="input-row"><input type="number" id="taxRate" value="15" min="0" max="50" step="0.5"><span class="suffix">%</span></div>
        <input type="range" id="taxRateSlider" min="0" max="50" value="15" step="0.5">
